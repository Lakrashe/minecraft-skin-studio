{
  // Engine and rig are pure TypeScript (PROJECT_RULES §1.1): no DOM lib and no
  // ambient browser types, so any use of window/document/canvas fails typecheck.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "lib": ["ES2023"],
    "types": [],
    "jsx": "preserve"
  },
  "include": ["src/engine", "src/rig"]
}
